# Copy to .env and fill in. .env is git-ignored: never commit it.
# Gemini (AI Studio -> Get API key). Free tier inputs may be used by Google to improve products.
GEMINI_API_KEY=
# Cloudflare: dashboard -> Workers AI -> Use REST API (account ID + a token with Workers AI Read + Edit)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Kaggle (phone-verified account): kaggle.com/settings -> API -> Generate New Token. Or run `kaggle auth login`.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
# Optional: ACE-Step server if not on localhost:8001, and its key if you set one
ACESTEP_API_URL=
ACESTEP_API_KEY=
